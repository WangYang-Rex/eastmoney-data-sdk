{
  "name": "eastmoney-data-sdk",
  "version": "1.0.1",
  "author": "Wang Yang",
  "description": "东方财富数据 SDK - 获取 A 股历史 K 线、实时行情、分时线等数据",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsx test/index.ts",
    "prepublishOnly": "npm run build",
    "npmlogin": "npm login --registry=https://registry.npmjs.org",
    "publish": "npm publish --registry=https://registry.npmjs.org"
  },
  "keywords": [
    "eastmoney",
    "stock",
    "quant",
    "kline",
    "a-stock",
    "finance",
    "trading",
    "量化",
    "东方财富",
    "股票"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WangYang-Rex/eastmoney-data-sdk"
  },
  "homepage": "https://github.com/WangYang-Rex/eastmoney-data-sdk#readme",
  "bugs": {
    "url": "https://github.com/WangYang-Rex/eastmoney-data-sdk/issues"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}